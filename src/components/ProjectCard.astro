---
interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="block border-2 border-black p-6 no-underline text-black hover:bg-black hover:text-white transition-colors duration-150"
>
  <h3 class="text-lg font-bold mb-2 uppercase tracking-wider">{title}</h3>
  <p class="text-sm leading-relaxed">{description}</p>
</a>
